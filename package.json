{
  "name": "pocketplan-budgeting",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "node --env-file=.env --import tsx --watch server/index.ts",
    "test": "node --experimental-strip-types --test test/calculations.test.ts test/server.integration.test.ts",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "start": "node --env-file=.env --import tsx server/index.ts"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.5.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "mysql2": "^3.24.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-redux": "^9.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "~5.7.2",
    "vite": "^6.1.0"
  }
}
