# Required. Create the MySQL database before starting Pocketplan.
MYSQL_URL=
# Optional: enables model-generated category and transaction-split suggestions via OpenRouter.
# Create a key at https://openrouter.ai/keys. The default router selects an available free model.
OPENROUTER_API_KEY=
# Optional override; defaults to openrouter/free.
OPENROUTER_MODEL=openrouter/free
# Optional path for one-time import of existing SQLite data.
DATABASE_PATH=./data/pocketplan.sqlite
